#compdef secondtake

_secondtake() {
    local -a subcommands
    subcommands=(
        'compare:secondtake compare subcommand'
    )
    if (( CURRENT == 2 )); then
        _describe -t commands 'secondtake subcommand' subcommands
        return
    fi
    case "${words[2]}" in
        compare) _arguments -s '--registration=[file path]:file:_files' '--judge=[file path]:file:_files' '-o+[file path]:file:_files' '--output=[file path]:file:_files' '-h[show help]' '--help[show help]' '*:file:_files' ;;
        *) _files ;;
    esac
}

_secondtake "$@"
